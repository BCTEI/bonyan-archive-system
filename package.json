{
  "name": "bonyan-archive-system",
  "version": "1.2.4",
  "description": "نظام الأرشيف الإلكتروني - مركز البنيان لتقنية والصناعيات الهندسية - مصراتة",
  "author": "مركز البنيان",
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "bun run build:electron && electron .",
    "build": "ng build",
    "build:electron": "ng build --configuration production --base-href app://-/ && tsc -p electron/tsconfig.json",
    "build:prod": "ng build --configuration production --base-href app://-/ && tsc -p electron/tsconfig.json",
    "dist": "bun run build:prod && electron-builder",
    "dist:win": "bun run build:prod && electron-builder --win",
    "dist:win-portable": "bun run build:prod && electron-builder --win portable",
    "dist:portable": "bun run dist:win-portable",
    "dist:linux-deb": "bun run build:prod && electron-builder --linux deb",
    "dist:linux": "bun run build:prod && electron-builder --linux",
    "dist:dir": "bun run build:prod && electron-builder --win --dir",
    "build:win": "bun run build:prod && electron-builder --win portable",
    "build:linux": "bun run build:prod && electron-builder --linux AppImage",
    "build:linux-deb": "bun run build:prod && electron-builder --linux deb",
    "test:login": "bun run build:prod && electron scripts/test-login.js",
    "postinstall": "electron-rebuild"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@fontsource/tajawal": "^5.2.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.6.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jasmine": "~5.1.0",
    "@types/node": "20",
    "autoprefixer": "^10.5.0",
    "electron": "30.5.1",
    "electron-builder": "25.1.8",
    "electron-rebuild": "3.2.9",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "3",
    "typescript": "~5.4.2"
  }
}
